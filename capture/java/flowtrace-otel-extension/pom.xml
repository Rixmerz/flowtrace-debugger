<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.flowtrace</groupId>
  <artifactId>flowtrace-otel-extension</artifactId>
  <version>2.2.0</version>
  <packaging>jar</packaging>

  <name>FlowTrace OTel Extension</name>
  <description>JSONL v2 emitter skeleton for FlowTrace OTel Java capture agent</description>

  <properties>
    <!-- The bytecode target is the FLOOR of what this agent can instrument,
         not the JDK we develop on. An agent compiled to 21 cannot be loaded
         into a Java 17 or 11 application — and the older the app, the more it
         needs tracing. So the target stays low deliberately and the CI matrix
         goes wide instead: see the `java-tests` job, which runs the suite on
         17, 21 and 25. -->
    <java.version>11</java.version>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <otel.version>1.61.0</otel.version>
    <otel.javaagent.version>2.27.0-alpha</otel.javaagent.version>
    <!-- Standalone fat-jar (not alpha) for the -javaagent flag. This is the
         agent the integration test actually runs, so it decides which JDKs
         FlowTrace can instrument at all: the agent rewrites bytecode, and one
         that predates a JDK does not recognize its class file version.

         It must also be >= otel.javaagent.version above. It sat at 2.11.0
         against a 2.27.0-alpha extension API — the unsafe direction, since the
         extension compiles against methods the running agent may not have.
         Newer agent than compile-time API is the supported upgrade path. -->
    <otel.javaagent.fatjar.version>2.30.0</otel.javaagent.fatjar.version>
    <bytebuddy.version>1.15.10</bytebuddy.version>
    <jackson.version>2.18.0</jackson.version>
    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencies>
    <!-- OTel API — provided by the OTel Java agent at runtime -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${otel.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
      <version>${otel.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-extension-autoconfigure-spi</artifactId>
      <version>${otel.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry.javaagent</groupId>
      <artifactId>opentelemetry-javaagent-extension-api</artifactId>
      <version>${otel.javaagent.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- ByteBuddy — provided (fallback capture path, Wave B) -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>${bytebuddy.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Test -->
    <!-- Jackson is used only by the tests, to parse the emitted JSONL back.
         The emitter is hand-rolled (it runs in the bootstrap/agent
         classloader where nothing else is available), so shipping Jackson in
         the extension jar added ~2 MB and a relocated copy of a library the
         runtime never touched. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Compiler -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- `release`, not source/target. With source/target, javac still
               links against the JDK running the build, so code calling an API
               added after 11 (Stream.toList, String.formatted, ...) compiles
               clean and then throws NoSuchMethodError inside a customer's
               Java 11 JVM. `release` compiles against the Java 11 API
               signatures, which makes the compatibility claim enforced rather
               than merely stated. -->
          <release>${java.version}</release>
        </configuration>
        <executions>
          <execution>
            <!-- Test sources only. The advice keys args by real parameter
                 name when the JVM exposes one, which requires the
                 MethodParameters attribute that only -parameters emits. The
                 test fixtures (Calculator, the arg-name tests) are compiled
                 with it so the named path is exercised end to end; the golden
                 truncation/error fixtures are compiled by bare javac and pin
                 the argN fallback. Main sources stay without it: the JDK does
                 not need our parameter names, and it keeps a compiled-without
                 -parameters method available to the tests. -->
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>-parameters</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Surefire — JUnit 5 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <!-- Pass basedir so FlowtraceIntegrationTest can locate jars -->
          <systemPropertyVariables>
            <project.basedir>${project.basedir}</project.basedir>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- Download standalone OTel javaagent fat-jar for integration tests.
           Runs during process-test-resources so it is available before tests.
           Requires network access; skipped automatically when artifact is
           already present in local repository. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>download-otel-agent</id>
            <phase>process-test-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.opentelemetry.javaagent</groupId>
                  <artifactId>opentelemetry-javaagent</artifactId>
                  <version>${otel.javaagent.fatjar.version}</version>
                  <type>jar</type>
                  <destFileName>opentelemetry-javaagent.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
              <!-- Do not fail the build if download fails (offline/sandbox) -->
              <skip>${skipOtelAgentDownload}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Shade — single extension jar. There are no compile-scope
           dependencies left to bundle (OTel/ByteBuddy are provided by the
           agent, Jackson is test-only); this stays so the jar the CLI ships
           is produced the same way it always was, and so that a dependency
           added by mistake is bundled rather than missing at runtime. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- Merges META-INF/services files so our SPI entries survive
                     alongside those of anything bundled. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- src/test/java21 holds fixtures/tests that need JDK 21 syntax
         (Thread.ofVirtual()) the module's release-11 floor would reject.
         Compiling them only when the build JDK is actually >= 21 keeps the
         JDK 17 leg of the CI matrix (java-tests, JDK 17/21/25) unaffected —
         see VirtualThreadIntegrationTest's class doc. -->
    <profile>
      <id>jdk21-fixtures</id>
      <activation>
        <jdk>[21,)</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>
            <executions>
              <execution>
                <id>testCompile-java21</id>
                <phase>test-compile</phase>
                <goals><goal>testCompile</goal></goals>
                <configuration>
                  <release>21</release>
                  <compileSourceRoots>
                    <compileSourceRoot>${project.basedir}/src/test/java21</compileSourceRoot>
                  </compileSourceRoots>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
