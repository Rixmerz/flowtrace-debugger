<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.flowtrace</groupId>
  <artifactId>flowtrace-otel-extension</artifactId>
  <version>2.1.0</version>
  <packaging>jar</packaging>

  <name>FlowTrace OTel Extension</name>
  <description>JSONL v2 emitter skeleton for FlowTrace OTel Java capture agent</description>

  <properties>
    <!-- The bytecode target is the FLOOR of what this agent can instrument,
         not the JDK we develop on. An agent compiled to 21 cannot be loaded
         into a Java 17 or 11 application — and the older the app, the more it
         needs tracing. So the target stays low deliberately and the CI matrix
         goes wide instead: see the `java-tests` job, which runs the suite on
         17, 21 and 25. -->
    <java.version>11</java.version>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <otel.version>1.61.0</otel.version>
    <otel.javaagent.version>2.27.0-alpha</otel.javaagent.version>
    <!-- Standalone fat-jar (not alpha) for the -javaagent flag. This is the
         agent the integration test actually runs, so it decides which JDKs
         FlowTrace can instrument at all: the agent rewrites bytecode, and one
         that predates a JDK does not recognize its class file version.

         It must also be >= otel.javaagent.version above. It sat at 2.11.0
         against a 2.27.0-alpha extension API — the unsafe direction, since the
         extension compiles against methods the running agent may not have.
         Newer agent than compile-time API is the supported upgrade path. -->
    <otel.javaagent.fatjar.version>2.30.0</otel.javaagent.fatjar.version>
    <bytebuddy.version>1.15.10</bytebuddy.version>
    <jackson.version>2.18.0</jackson.version>
    <junit.version>5.11.0</junit.version>
  </properties>

  <dependencies>
    <!-- OTel API — provided by the OTel Java agent at runtime -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${otel.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
      <version>${otel.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-extension-autoconfigure-spi</artifactId>
      <version>${otel.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry.javaagent</groupId>
      <artifactId>opentelemetry-javaagent-extension-api</artifactId>
      <version>${otel.javaagent.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- ByteBuddy — provided (fallback capture path, Wave B) -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>${bytebuddy.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Jackson — compile + shaded to avoid user classpath collision -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Compiler -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- `release`, not source/target. With source/target, javac still
               links against the JDK running the build, so code calling an API
               added after 11 (Stream.toList, String.formatted, ...) compiles
               clean and then throws NoSuchMethodError inside a customer's
               Java 11 JVM. `release` compiles against the Java 11 API
               signatures, which makes the compatibility claim enforced rather
               than merely stated. -->
          <release>${java.version}</release>
        </configuration>
      </plugin>

      <!-- Surefire — JUnit 5 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <!-- Pass basedir so FlowtraceIntegrationTest can locate jars -->
          <systemPropertyVariables>
            <project.basedir>${project.basedir}</project.basedir>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- Download standalone OTel javaagent fat-jar for integration tests.
           Runs during process-test-resources so it is available before tests.
           Requires network access; skipped automatically when artifact is
           already present in local repository. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>download-otel-agent</id>
            <phase>process-test-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.opentelemetry.javaagent</groupId>
                  <artifactId>opentelemetry-javaagent</artifactId>
                  <version>${otel.javaagent.fatjar.version}</version>
                  <type>jar</type>
                  <destFileName>opentelemetry-javaagent.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
              <!-- Do not fail the build if download fails (offline/sandbox) -->
              <skip>${skipOtelAgentDownload}</skip>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Shade — uber-jar with relocated Jackson -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- Merges META-INF/services files from all jars so our SPI
                     entries survive alongside Jackson's entries. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <relocations>
                <relocation>
                  <pattern>com.fasterxml.jackson</pattern>
                  <shadedPattern>io.flowtrace.shaded.jackson</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
