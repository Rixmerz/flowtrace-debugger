node_modules/
vendor/java/*.jar

# Vendored capture layers — generated by scripts/vendor.mjs at pack time.
# Not committed: they are copies of capture/, and a stale copy in git would be
# a second source of truth that silently disagrees with the real one.
#
# vendor/dashboard/ is the exception: it is an esbuild bundle (a real build
# artifact, not a copy of live source — see scripts/bundle-dashboard.mjs),
# committed on purpose so `make check-bundle` can diff a fresh rebuild
# against it and catch drift, the same way plugin/mcp/server.bundle.js is.
# `vendor/*` (not `vendor/`) so git still descends into vendor/dashboard/ to
# apply the negation below — a negated pattern cannot re-include a path whose
# parent directory is itself excluded.
vendor/*
!vendor/dashboard/

*.tgz
