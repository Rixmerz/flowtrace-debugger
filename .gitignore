# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Java
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.tox/
.venv/
venv/
# Anchored deliberately. Unanchored `build/` and `dist/` match at ANY depth,
# which is the same over-broad shape as the `*.jsonl` rule recorded below —
# a future capture/<lang>/dist/ that needs committing would vanish silently.
capture/python/build/
capture/python/dist/

# Node
node_modules/

# Build output. The MCP server the plugin actually runs is NOT here: it is a
# committed esbuild bundle at plugin/mcp/server.bundle.js, because a plugin
# install has no build step. See mcp-server/scripts/bundle.mjs.
mcp-server/dist/

# Logs
*.log

# FlowTrace runtime output.
# NOTE: scoped deliberately — a blanket `*.jsonl` also swallowed
# examples/golden/**/expected.jsonl, which is why the golden fixtures
# could never be committed and `make validate-schema` validated nothing.
flowtrace.jsonl
flowtrace-*.jsonl
**/flowtrace.jsonl
**/flowtrace-*.jsonl

# The Go (and Python) runtimes' default output directory when FLOWTRACE_OUTPUT
# isn't set (see capture/go/flowtracert/emitter.go, capture/python's
# emitter.py) — a run artifact, never source, and would otherwise ship in the
# npm tarball via vendor.mjs's copyDir (see that script's own filter).
**/.flowtrace/

# Per-developer Claude Code state, created the moment anyone approves a
# permission. Never shared.
.claude/settings.local.json

# Benchmark output. Timestamped, one file per language per run, and the harness
# writes it into the tracked benchmarks/ directory — six all-zero results were
# committed this way.
benchmarks/results-*.json

# jig was removed wholesale (see CLAUDE.md). A tombstone so a stray tool that
# still knows the name cannot re-add it.
.jig/

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Eclipse
.classpath
.project
.settings/

# NetBeans
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# OS files
.DS_Store
Thumbs.db
