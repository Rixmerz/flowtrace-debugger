# Node
node_modules/

# Build output. The MCP server the plugin actually runs is NOT here: it is a
# committed esbuild bundle at plugin/mcp/server.bundle.js, because a plugin
# install has no build step. See mcp-server/scripts/bundle.mjs.
mcp-server/dist/

# Logs
*.log

# FlowTrace runtime output.
# NOTE: scoped deliberately — a blanket `*.jsonl` also swallowed
# examples/golden/**/expected.jsonl, which is why the golden fixtures
# could never be committed and `make validate-schema` validated nothing.
flowtrace.jsonl
flowtrace-*.jsonl
**/flowtrace.jsonl
**/flowtrace-*.jsonl

# The Go (and Python) runtimes' default output directory when FLOWTRACE_OUTPUT
# isn't set (see capture/go/flowtracert/emitter.go, capture/python's
# emitter.py) — a run artifact, never source, and would otherwise ship in the
# npm tarball via vendor.mjs's copyDir (see that script's own filter).
**/.flowtrace/

