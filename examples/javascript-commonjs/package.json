{
  "name": "flowtrace-example-commonjs",
  "version": "1.0.0",
  "description": "FlowTrace CommonJS Example Application",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "start:trace": "node --import ../../capture/node/src/bootstrap.mjs app.js",
    "start:trace:debug": "FLOWTRACE_STDOUT=true node --import ../../capture/node/src/bootstrap.mjs app.js",
    "start:trace:filter": "FLOWTRACE_PACKAGE_PREFIX=app node --import ../../capture/node/src/bootstrap.mjs app.js"
  },
  "keywords": [
    "flowtrace",
    "example",
    "commonjs"
  ],
  "author": "FlowTrace",
  "license": "MIT"
}
